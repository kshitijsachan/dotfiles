# Copied to ~/.gitconfig.local by install.sh. Fill in, don't commit.
[user]
	name = Your Name
	email = you@example.com
	# 1Password → your SSH key → "Copy public key", paste here:
	# signingkey = ssh-ed25519 AAAA...

# Uncomment once signingkey is set to sign every commit via 1Password
# [gpg]
# 	format = ssh
# [gpg "ssh"]
# 	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
# [commit]
# 	gpgsign = true
